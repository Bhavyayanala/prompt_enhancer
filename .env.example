# Copy this file to .env and fill in ONE provider key. Never commit .env.

# Which AI provider the agent uses: gemini | groq | mock
#   mock = offline scripted demo (no key, no real AI) for trying the app and the tests
LLM_PROVIDER=gemini

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout for one AI call in milliseconds (504 when exceeded)
AI_TIMEOUT_MS=60000

# Maximum tool calls per agent run
AGENT_MAX_STEPS=5

# Allowed browser origins for CORS (comma separated). "*" is fine for local use.
# For the deployed backend set it to your Vercel/Netlify URL.
CORS_ORIGIN=*
