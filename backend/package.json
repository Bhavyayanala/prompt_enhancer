{
  "name": "prompt-enhancer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend and CLI for the Prompt Enhancer planning agent",
  "type": "commonjs",
  "main": "dist/server.js",
  "bin": { "prompt-enhancer": "dist/cli.js" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.9"
  }
}
